{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "remote",
        "address": "tcp://1.1.1.1",
        "detour": "socks-out"
      },
      {
        "tag": "remote-udp",
        "address": "udp://1.1.1.1",
        "detour": "socks-out"
      },
      {
        "tag": "backup",
        "address": "tcp://8.8.8.8",
        "detour": "socks-out"
      },
      {
        "tag": "local",
        "address": "local"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "sb-tun",
      "inet4_address": "172.19.0.1/30",
      "mtu": 1400,
      "auto_route": true,
      "strict_route": true,
      "sniff": true,
      "sniff_override_destination": false,
      "stack": "gvisor"
    },
    {
      "type": "mixed",
      "tag": "ping-in",
      "listen": "127.0.0.1",
      "listen_port": 2081
    }
  ],
  "outbounds": [
    {
      "type": "socks",
      "tag": "socks-out",
      "server": "vpn.example.com",
      "server_port": 9999,
      "version": "5"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff",
        "sniffer": [
          "dns"
        ]
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "::/0"
        ],
        "action": "reject"
      },
      {
        "domain": [
          "vpn.example.com"
        ],
        "outbound": "direct"
      }
    ],
    "final": "socks-out"
  }
}
